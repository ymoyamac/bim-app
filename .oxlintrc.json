{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["react", "typescript", "import", "unicorn", "oxc"],
    "env": {
        "browser": true,
        "es2024": true
    },
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "eqeqeq": "warn",
        "no-unused-vars": "warn",
        "typescript/no-explicit-any": "error"
    },
    "ignorePatterns": ["dist", "build", "coverage", "node_modules"]
}

